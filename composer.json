{
    "name": "robelsust/laravel-data-pipeline",
    "description": "High-throughput, memory-bounded (O(1)) streaming ETL data pipeline for Laravel with atomic checkpoints and surgical quarantine recovery.",
    "keywords": [
        "laravel",
        "pipeline",
        "etl",
        "data-pipeline",
        "streaming",
        "csv",
        "batch-insert",
        "upsert",
        "deduplication",
        "quarantine"
    ],
    "homepage": "https://github.com/robelsust/laravel-data-pipeline",
    "license": "MIT",
    "authors": [
        {
            "name": "Robel",
            "email": "robelsust@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "opis/closure": "^3.6"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Robel\\DataPipeline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Robel\\DataPipeline\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Robel\\DataPipeline\\DataPipelineServiceProvider"
            ],
            "aliases": {
                "DataPipeline": "Robel\\DataPipeline\\Facades\\DataPipeline"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
