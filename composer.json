{
    "name": "robelsust/laravel-data-pipeline",
    "description": "Streaming ETL data pipeline for Laravel with transactional checkpoints, batch validation, deduplication and quarantine recovery.",
    "keywords": [
        "laravel",
        "pipeline",
        "etl",
        "data-pipeline",
        "streaming",
        "csv",
        "batch-insert",
        "upsert",
        "deduplication",
        "quarantine"
    ],
    "homepage": "https://github.com/robelsust/laravel-data-pipeline",
    "license": "MIT",
    "authors": [
        {
            "name": "Robel",
            "email": "robelsust@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "laravel/serializable-closure": "^1.3|^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "larastan/larastan": "^3.0",
        "predis/predis": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Robel\\DataPipeline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Robel\\DataPipeline\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Robel\\DataPipeline\\DataPipelineServiceProvider"
            ],
            "aliases": {
                "DataPipeline": "Robel\\DataPipeline\\Facades\\DataPipeline"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/composer.lock",
            "/.git",
            "/.env",
            "/.phpunit.result.cache",
            "/.pest",
            "/tests",
            "/.github",
            "/phpunit.xml",
            "/phpstan.neon"
        ]
    }
}
